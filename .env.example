# ===== Database =====
DB_HOST=ambatukos-db
DB_PORT=3306
DB_NAME=ambatukos
DB_USER=ambatukos
DB_PASSWORD=ambatukos_pass
DB_ROOT_PASSWORD=root_pass

# ===== Aplikasi =====
# Port di-bind ke IP gateway network ambatukos (di belakang reverse proxy)
BIND_IP=172.20.0.1
APP_PORT=8079
DP_PERSEN=30
BANK_INFO=BCA 1234567890 a.n. AmbatuKos
SCHEDULER_INTERVAL=300

# ===== Akun awal (dibuat otomatis saat database masih kosong) =====
SEED_PEMILIK_PASSWORD=pemilik123
SEED_ADMIN_PASSWORD=admin123
SEED_DEMO=true
SEED_PENYEWA_PASSWORD=penyewa123

# ===== Cloudflare Turnstile (Captcha Challenge) =====
CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# ===== Google OAuth (Opsional) =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8079/auth/google/callback

